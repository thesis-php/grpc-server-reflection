{
    "name": "thesis/grpc-server-reflection",
    "description": "gRPC server reflection protocol implementation.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "kafkiansky",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Thesis Team",
            "homepage": "https://github.com/orgs/thesis-php/people"
        }
    ],
    "require": {
        "php": "^8.4",
        "amphp/amp": "^3.1",
        "thesis/googleapis-rpc-types": "^0.1.6",
        "thesis/grpc": "^0.1.1",
        "thesis/protobuf": "^0.1.8",
        "thesis/protoregistry": "^0.1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4",
        "symfony/var-dumper": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Grpc\\Reflection\\V1\\": "genproto/Grpc/Reflection/V1",
            "Grpc\\Reflection\\V1alpha\\": "genproto/Grpc/Reflection/V1alpha"
        },
        "files": [
            "genproto/Grpc/Reflection/autoload.metadata.php",
            "src/register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Grpc\\Server\\Reflection\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
